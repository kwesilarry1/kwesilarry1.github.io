---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  date: Date;
  tags: string[];
}

const { title, description, date, tags } = Astro.props;

const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={`${title} | 0xWizard`} description={description}>
  <article class="post">
    <header class="post-header container">
      <p class="terminal-label">$ cat /writeups/{title.toLowerCase().replaceAll(" ", "-")}</p>

      <h1>{title}</h1>

      {description && <p class="description">{description}</p>}

      <div class="metadata">
        <time datetime={date.toISOString()}>
          {formattedDate}
        </time>

        <span>·</span>

        <div class="tags">
          {tags.map((tag) => (
            <a href={`/tags/${tag.toLowerCase()}`}>#{tag}</a>
          ))}
        </div>
      </div>
    </header>

    <div class="post-content container">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    padding: 5rem 0;
  }

  .post-header {
    max-width: 900px;
    margin-bottom: 4rem;
  }

  .terminal-label {
    margin-bottom: 1.5rem;
    color: var(--accent);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.85rem;
  }

  .post-header h1 {
    max-width: 900px;
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .description {
    max-width: 750px;
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .metadata {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
    margin-top: 1.5rem;
    color: var(--muted);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.8rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .tags a {
    color: var(--accent);
  }

  .post-content {
    max-width: 850px;
  }

  .post-content :global(h2) {
    margin-top: 4rem;
    margin-bottom: 1rem;
    font-size: 2rem;
  }

  .post-content :global(h3) {
    margin-top: 3rem;
    font-size: 1.4rem;
  }

  .post-content :global(p) {
    margin: 1.2rem 0;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    padding-left: 1.5rem;
  }

  .post-content :global(li) {
    margin: 0.5rem 0;
  }

  .post-content :global(blockquote) {
    margin: 2rem 0;
    padding: 1rem 1.5rem;
    border-left: 3px solid var(--accent);
    background: var(--panel);
    color: var(--muted);
  }

  .post-content :global(img) {
    display: block;
    margin: 2rem auto;
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .post-content :global(a) {
    color: var(--accent);
  }

  .post-content :global(hr) {
    margin: 3rem 0;
    border: 0;
    border-top: 1px solid var(--border);
  }

  .post-content :global(code) {
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
    background: var(--panel);
    color: var(--accent);
  }

  .post-content :global(pre) {
    margin: 2rem 0;
  }

  .post-content :global(pre code) {
    padding: 0;
    background: transparent;
    color: inherit;
  }
</style>
