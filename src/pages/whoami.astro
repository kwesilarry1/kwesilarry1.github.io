---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
title="Whoami | 0xWizard"
description="About Kwesi Larry, also known online as 0xWizard. Application security practitioner, bug hunter, and cybersecurity student."

>

  <section class="whoami-page">
    <div class="container">


  <!-- Terminal introduction -->
  <div class="terminal">
    <div class="terminal-bar" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>

    <div class="terminal-body">
      <p class="command">
        <span class="green">wizard@0xwizard</span>:<span class="blue">~</span>$ whoami
      </p>

      <h1>Appiah Bismark</h1>

      <p class="alias">
        Also known online as <strong> Kwesi Larry (0xWizard) </strong>.
      </p>

      <p>
        I'm a cybersecurity student focused on
        <strong> application security</strong>,
        <strong> bug bounty hunting</strong>, and
        <strong> security research</strong>.
      </p>

      <p>
        I enjoy understanding how applications work, finding where
        they break, and learning how they can be built more securely.
        I also explore robotics, embedded systems, and other areas
        where software meets the physical world.
      </p>

      <p>
        <span class="green">wizard@0xwizard</span>:<span class="blue">~</span>$
        cat philosophy.txt
      </p>

      <blockquote>
        Learn how things work.<br />
        Break them responsibly.<br />
        Build them better.
      </blockquote>

      <p class="cursor">
        <span class="green">wizard@0xwizard</span>:<span class="blue">~</span>$
        _
      </p>
    </div>
  </div>

 

  <!-- Education -->
  <section class="profile-section" id="education">
    <div class="section-heading">
      <p class="terminal-label">$ cat education.txt</p>
      <h2>Education</h2>
    </div>

    <div class="timeline">

      <article class="timeline-item">
        <div class="timeline-marker"></div>

        <div class="timeline-content">
          <div class="timeline-meta">
            <span>2025 → 2028</span>
            <span>University</span>
          </div>

          <h3>University of Mines and Technology</h3>

          <p class="role">
            BSc. Cybersecurity
          </p>

          <p>
            Studying cybersecurity with a focus on the technical
            foundations of information security, networking,
            application security, and security engineering.
          </p>
        </div>
      </article>

      <article class="timeline-item">
        <div class="timeline-marker"></div>

        <div class="timeline-content">
          <div class="timeline-meta">
            <span>2020 → 2023</span>
            <span>Senior High School</span>
          </div>

          <h3>Opoku Ware School</h3>

          <p class="role">
            General Arts
          </p>
        </div>
      </article>

    </div>
  </section>

  <!-- Certifications -->
  <section class="profile-section" id="certifications">
    <div class="section-heading">
      <p class="terminal-label">$ ls certifications/</p>
      <h2>Achievements &amp; Certifications</h2>
    </div>

    <div class="certifications">
 <article class="cert-card">
        <div class="cert-number">01</div>

        <div class="cert-content">
          <p class="cert-status">CERTIFIED</p>

          <h3>API Security Certified Practitioner</h3>

          <p>
            ApisecUniversity
          </p>

          <span class="cert-result">
            ASCP · Passed
          </span>
        </div>
      </article>

      <article class="cert-card">
        <div class="cert-number">02</div>

        <div class="cert-content">
          <p class="cert-status">CERTIFIED</p>

          <h3>Certified AppSec Practitioner</h3>

          <p>
            SecOps Group
          </p>

          <a
            href="https://candidate.speedexam.net/certificate.aspx?SSTATE=am4131EniU8ntjp4bO5mXXSSxZ70gTmrzb0+FVm+Qs86EpnR/ivTHPDv3XyPY2nZqD0g1cDNZBEQPcr8rHOaE93NM7bSS0pOR/fKYM+3OCc="
            target="_blank"
            rel="noopener noreferrer"
          >
            View Certificate ↗
          </a>
        </div>
      </article>

     

      <article class="cert-card">
        <div class="cert-number">03</div>

        <div class="cert-content">
          <p class="cert-status">CERTIFIED</p>

          <h3>Junior Penetration Tester</h3>

          <p>
            TryHackMe
          </p>

          <a
            href="https://tryhackme-certificates.s3-eu-west-1.amazonaws.com/THM-A2UKXSWHOZ.pdf"
            target="_blank"
            rel="noopener noreferrer"
          >
            View Certificate ↗
          </a>
        </div>
      </article>

    </div>
  </section>

  <!-- Work Experience -->
  <section class="profile-section" id="experience">
    <div class="section-heading">
      <p class="terminal-label">$ cat experience.txt</p>
      <h2>Work Experience</h2>
    </div>

    <div class="timeline">

      <article class="timeline-item">
        <div class="timeline-marker"></div>

        <div class="timeline-content">
          <div class="timeline-meta">
            <span>Feb 2025 → Oct 2025</span>
            <span>Remote</span>
          </div>

          <h3>Cybersecurity Instructor</h3>

          <p class="role">
            HIVE Consult
          </p>

          <ul>
            <li>
              Delivered penetration testing and Introduction to Linux
              courses covering both practical skills and theoretical
              foundations.
            </li>

            <li>
              Developed curriculum content, practical labs, and
              assessments for cybersecurity learners.
            </li>

            <li>
              Mentored students and helped prepare them for practical
              cybersecurity challenges.
            </li>
          </ul>

          <a
            href="https://www.linkedin.com/company/hivesecurity-consult/"
            target="_blank"
            rel="noopener noreferrer"
          >
            HIVE Consult ↗
          </a>
        </div>
      </article>

      <article class="timeline-item">
        <div class="timeline-marker"></div>

        <div class="timeline-content">
          <div class="timeline-meta">
            <span>Apr 2025 → May 2025</span>
            <span>Remote</span>
          </div>

          <h3>Intern Penetration Tester</h3>

          <p class="role">
            Hack Secure
          </p>

          <ul>
            <li>
              Conducted penetration testing on web applications,
              networks, and systems.
            </li>

            <li>
              Identified vulnerabilities and assessed the security
              posture of tested environments.
            </li>

            <li>
              Produced detailed reports describing vulnerabilities,
              potential exploitation paths, and recommended
              remediation.
            </li>
          </ul>

          <a
            href="https://www.linkedin.com/company/hacksecureofficial/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Hack Secure ↗
          </a>
        </div>
      </article>

    </div>
  </section>
 <!-- Skills -->
  <section class="profile-section" id="skills">
    <div class="section-heading">
      <p class="terminal-label">$ ls skills/</p>
      <h2>Skills</h2>
    </div>

    <div class="skills-grid">
      <article class="skill-card">
        <span class="skill-icon">01</span>
        <h3>Application Security</h3>
        <ul>
          <li>OWASP Top 10</li>
          <li>Web Application Testing</li>
          <li>API Security</li>
          <li>Vulnerability Assessment</li>
          <li>Code Review</li>
          <li>Security Reporting</li>
        </ul>
      </article>

      <article class="skill-card">
        <span class="skill-icon">02</span>
        <h3>Security Research</h3>
        <ul>
          <li>Bug Bounty Hunting</li>
          <li>Reconnaissance</li>
          <li>OSINT</li>
          <li>Security Testing</li>
          <li>Vulnerability Research</li>
          <li>Web Security</li>
        </ul>
      </article>

      <article class="skill-card">
        <span class="skill-icon">03</span>
        <h3>Programming</h3>
        <ul>
          <li>Python</li>
          <li>Bash</li>
          <li>Dart / Flutter</li>
          <li>JavaScript</li>
          <li>Git</li>
          <li>Markdown</li>
        </ul>
      </article>

      <article class="skill-card">
        <span class="skill-icon">04</span>
        <h3>Systems &amp; Networking</h3>
        <ul>
          <li>Linux Administration</li>
          <li>Networking</li>
          <li>Docker</li>
          <li>Wireless Security</li>
          <li>Network Testing</li>
          <li>Embedded Systems</li>
        </ul>
      </article>
    </div>
  </section>

  <!-- Write-ups -->
  <section class="profile-section writeups-section" id="writeups">
    <div class="section-heading">
      <p class="terminal-label">$ ls ~/writeups/</p>
      <h2>Writeups</h2>
    </div>

    <div class="writeups-terminal">
      <p>
        <span class="green">wizard@0xwizard</span>:<span class="blue">~</span>$
        cd ~/writeups
      </p>

      <p>
        I document security research, vulnerability analysis,
        learning notes, and practical experiments here.
      </p>

      <a href="/writeups/" class="terminal-link">
        ./view-writeups.sh →
      </a>
    </div>
  </section>

</div>


  </section>
</BaseLayout>

<style>
  .whoami-page {
    padding: 5rem 0 7rem;
  }

  /* Terminal */

  .terminal {
    max-width: 950px;
    margin: 0 auto;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--panel);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
  }

  .terminal-bar {
    display: flex;
    gap: 7px;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-soft);
  }

  .terminal-bar span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--border);
  }

  .terminal-body {
    padding: 2.5rem;
    color: var(--muted);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.9rem;
    line-height: 1.9;
  }

  .terminal-body p {
    margin: 0 0 1.5rem;
  }

  .command {
    color: var(--text);
  }

  .green {
    color: var(--accent);
  }

  .blue {
    color: #58a6ff;
  }

  .terminal-body h1 {
    margin: 0 0 0.5rem;
    color: var(--text);
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;
    font-size: clamp(2.8rem, 7vw, 5rem);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .alias {
    margin-bottom: 2rem !important;
  }

  .terminal-body strong {
    color: var(--text);
  }

  blockquote {
    margin: 1.5rem 0 2rem;
    padding: 1rem 1.5rem;
    border-left: 3px solid var(--accent);
    background: var(--bg-soft);
    color: var(--text);
  }

  .cursor {
    margin-bottom: 0 !important;
  }

  /* Sections */

  .profile-section {
    max-width: 950px;
    margin: 7rem auto 0;
  }

  .section-heading {
    margin-bottom: 2rem;
  }

  .terminal-label {
    margin: 0 0 0.5rem;
    color: var(--accent);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.8rem;
  }

  .section-heading h2 {
    margin: 0;
    color: var(--text);
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: -0.04em;
  }

  /* Skills */

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .skill-card {
    padding: 1.7rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--panel);
  }

  .skill-card:hover {
    border-color: var(--accent-dim);
  }

  .skill-icon {
    color: var(--accent);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.7rem;
  }

  .skill-card h3 {
    margin: 0.8rem 0 1rem;
    font-size: 1.2rem;
  }

  .skill-card ul {
    margin: 0;
    padding-left: 1.2rem;
    color: var(--muted);
  }

  .skill-card li {
    margin: 0.35rem 0;
    font-size: 0.9rem;
  }

  /* Timeline */

  .timeline {
    position: relative;
    margin-left: 0.5rem;
    padding-left: 2rem;
    border-left: 1px solid var(--border);
  }

  .timeline-item {
    position: relative;
    padding-bottom: 3rem;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-marker {
    position: absolute;
    top: 0.25rem;
    left: -2.35rem;
    width: 10px;
    height: 10px;
    border: 2px solid var(--accent);
    border-radius: 50%;
    background: var(--bg);
    box-shadow: 0 0 0 4px var(--bg);
  }

  .timeline-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 0.6rem;
    color: var(--accent);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.72rem;
  }

  .timeline-content h3 {
    margin: 0;
    color: var(--text);
    font-size: 1.4rem;
  }

  .role {
    margin: 0.3rem 0 1rem;
    color: var(--muted);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.8rem;
  }

  .timeline-content > p:not(.role) {
    color: var(--muted);
  }

  .timeline-content ul {
    margin: 1rem 0;
    padding-left: 1.3rem;
    color: var(--muted);
  }

  .timeline-content li {
    margin: 0.6rem 0;
  }

  .timeline-content a {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.75rem;
  }

  /* Certifications */

  .certifications {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .cert-card {
    display: flex;
    min-height: 240px;
    flex-direction: column;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--panel);
  }

  .cert-card:hover {
    border-color: var(--accent-dim);
  }

  .cert-number {
    color: var(--accent);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.7rem;
  }

  .cert-content {
    margin-top: auto;
  }

  .cert-status {
    margin: 0 0 0.5rem;
    color: var(--accent);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
  }

  .cert-content h3 {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.35;
  }

  .cert-content > p {
    margin: 0.5rem 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .cert-content a {
    display: inline-block;
    margin-top: 0.7rem;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.72rem;
  }

  .cert-result {
    display: inline-block;
    margin-top: 0.5rem;
    color: var(--text);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.7rem;
  }

  /* Write-ups */

  .writeups-terminal {
    padding: 1.7rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--panel);
    color: var(--muted);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.82rem;
    line-height: 1.8;
  }

  .writeups-terminal p {
    margin: 0 0 1rem;
  }

  .terminal-link {
    display: inline-block;
    margin-top: 0.5rem;
    color: var(--accent);
  }

  .terminal-link:hover {
    text-decoration: none;
  }

  /* Mobile */

  @media (max-width: 800px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }

    .certifications {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .whoami-page {
      padding: 4rem 0 5rem;
    }

    .terminal-body {
      padding: 1.4rem;
      font-size: 0.78rem;
    }

    .profile-section {
      margin-top: 5rem;
    }

    .timeline {
      margin-left: 0.25rem;
      padding-left: 1.5rem;
    }

    .timeline-marker {
      left: -1.85rem;
    }

    .timeline-meta {
      flex-direction: column;
      gap: 0.2rem;
    }
  }
</style>
