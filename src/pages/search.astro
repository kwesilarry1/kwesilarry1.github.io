
---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const writeups = (await getCollection("writeups"))
  .filter((writeup) => !writeup.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const searchData = [];

for (const writeup of writeups) {
  const { Content } = await render(writeup);

  searchData.push({
    slug: writeup.id,
    title: writeup.data.title,
    description: writeup.data.description ?? "",
    tags: writeup.data.tags,
    date: writeup.data.date.toISOString(),
    url: `/writeups/${writeup.id}/`,
    content: writeup.body ?? "",
  });
}
---

<BaseLayout
  title="Search | 0xWizard"
  description="Search 0xWizard write-ups."
>
  <section class="search-page">
    <div class="container">
      <div class="terminal-heading">
        <p>$ grep -Rni "your-query" /writeups</p>

        <h1>Search</h1>

        <p class="intro">
          Search through the entire 0xWizard write-up archive.
        </p>
      </div>

      <div class="search-box">
        <span class="prompt">$</span>

        <input
          id="search-input"
          type="search"
          placeholder="search write-ups..."
          autocomplete="off"
          spellcheck="false"
          aria-label="Search write-ups"
        />

        <kbd>/</kbd>
      </div>

      <div id="search-status" class="search-status">
        <span>{writeups.length}</span> write-ups indexed
      </div>

      <div id="search-results" class="results">
        {
          writeups.map((writeup) => (
            <article class="result">
              <a href={`/writeups/${writeup.id}/`} class="result-link">
                <div class="result-header">
                  <h2>{writeup.data.title}</h2>

                  <time datetime={writeup.data.date.toISOString()}>
                    {writeup.data.date.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    })}
                  </time>
                </div>

                {
                  writeup.data.description && (
                    <p class="result-description">
                      {writeup.data.description}
                    </p>
                  )
                }

                <div class="tags">
                  {writeup.data.tags.map((tag) => (
                    <span>#{tag}</span>
                  ))}
                </div>
              </a>
            </article>
          ))
        }
      </div>

      <div id="empty-state" class="empty-state" hidden>
        <p class="terminal-error">grep: no matches found</p>
        <p>Try another keyword.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ searchData }}>
  const input = document.querySelector("#search-input");
  const results = document.querySelector("#search-results");
  const status = document.querySelector("#search-status");
  const emptyState = document.querySelector("#empty-state");

  const normalize = (text) => {
    return text
      .toLowerCase()
      .normalize("NFKD")
      .replace(/[^\w\s-]/g, " ");
  };

  const formatDate = (dateString) => {
    return new Date(dateString).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    });
  };

  const createResult = (item) => {
    const article = document.createElement("article");
    article.className = "result";

    const link = document.createElement("a");
    link.className = "result-link";
    link.href = item.url;

    const header = document.createElement("div");
    header.className = "result-header";

    const title = document.createElement("h2");
    title.textContent = item.title;

    const date = document.createElement("time");
    date.textContent = formatDate(item.date);
    date.dateTime = item.date;

    header.append(title, date);

    const description = document.createElement("p");
    description.className = "result-description";
    description.textContent =
      item.description || "No description available.";

    const tags = document.createElement("div");
    tags.className = "tags";

    item.tags.forEach((tag) => {
      const tagElement = document.createElement("span");
      tagElement.textContent = `#${tag}`;
      tags.appendChild(tagElement);
    });

    link.append(header, description, tags);
    article.appendChild(link);

    return article;
  };

  const performSearch = () => {
    const query = input.value.trim();

    if (!query) {
      results.innerHTML = "";

      searchData.forEach((item) => {
        results.appendChild(createResult(item));
      });

      emptyState.hidden = true;

      status.innerHTML =
        `<span>${searchData.length}</span> write-ups indexed`;

      return;
    }

    const terms = normalize(query)
      .split(/\s+/)
      .filter(Boolean);

    const matches = searchData.filter((item) => {
      const searchableText = normalize(
        [
          item.title,
          item.description,
          item.slug,
          item.tags.join(" "),
          item.content,
        ].join(" ")
      );

      return terms.every((term) =>
        searchableText.includes(term)
      );
    });

    results.innerHTML = "";

    matches.forEach((item) => {
      results.appendChild(createResult(item));
    });

    emptyState.hidden = matches.length !== 0;

    if (matches.length === 0) {
      status.innerHTML = "<span>0</span> results found";
    } else if (matches.length === 1) {
      status.innerHTML = "<span>1</span> result found";
    } else {
      status.innerHTML =
        `<span>${matches.length}</span> results found`;
    }
  };

  input.addEventListener("input", performSearch);

  document.addEventListener("keydown", (event) => {
    const target = event.target;

    if (
      event.key === "/" &&
      target instanceof HTMLElement &&
      target.tagName !== "INPUT" &&
      target.tagName !== "TEXTAREA"
    ) {
      event.preventDefault();
      input.focus();
    }

    if (
      event.key === "Escape" &&
      document.activeElement === input
    ) {
      input.value = "";
      performSearch();
      input.blur();
    }
  });
</script>

<style>
  .search-page {
    padding: 5rem 0 6rem;
  }

  .terminal-heading {
    max-width: 800px;
    margin-bottom: 3rem;
  }

  .terminal-heading > p:first-child {
    margin-bottom: 1.5rem;
    color: var(--accent);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.85rem;
  }

  .terminal-heading h1 {
    margin: 0;
    font-size: clamp(3rem, 7vw, 5rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .intro {
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: 1.05rem;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    max-width: 850px;
    padding: 1rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--code);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .search-box:focus-within {
    border-color: var(--accent-dim);
    box-shadow: 0 0 0 3px rgba(0, 255, 136, 0.08);
  }

  .prompt {
    color: var(--accent);
    font-family: "JetBrains Mono", monospace;
    font-weight: 700;
  }

  input {
    width: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text);
    font-family: "JetBrains Mono", monospace;
    font-size: 1rem;
  }

  input::placeholder {
    color: #555;
  }

  kbd {
    padding: 0.2rem 0.45rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--muted);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.7rem;
  }

  .search-status {
    margin: 1.5rem 0;
    color: var(--muted);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.8rem;
  }

  .search-status span {
    color: var(--accent);
  }

  .results {
    max-width: 850px;
  }

  .result {
    border-top: 1px solid var(--border);
  }

  .result:last-child {
    border-bottom: 1px solid var(--border);
  }

  .result-link {
    display: block;
    padding: 1.8rem 0;
    color: inherit;
    text-decoration: none;
  }

  .result-link:hover {
    text-decoration: none;
  }

  .result-link:hover h2 {
    color: var(--accent);
  }

  .result-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .result-header h2 {
    margin: 0;
    color: var(--text);
    font-size: 1.35rem;
    transition: color 0.2s ease;
  }

  time {
    flex-shrink: 0;
    color: var(--muted);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.75rem;
  }

  .result-description {
    max-width: 700px;
    margin: 0.7rem 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.8rem;
  }

  .tags span {
    color: var(--accent-dim);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.75rem;
  }

  .empty-state {
    max-width: 850px;
    padding: 3rem 0;
    color: var(--muted);
    text-align: center;
  }

  .terminal-error {
    margin-bottom: 0.5rem;
    color: var(--accent);
    font-family: "JetBrains Mono", monospace;
  }

  @media (max-width: 650px) {
    .search-page {
      padding-top: 3rem;
    }

    .result-header {
      display: block;
    }

    time {
      display: block;
      margin-top: 0.5rem;
    }

    kbd {
      display: none;
    }
  }
</style>

