---

import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
const projects = await getCollection("projects");

return projects.map((project) => ({
params: {
slug: project.id,
},
props: {
project,
},
}));
}

const { project } = Astro.props;
const { Content } = await render(project);

const {
title,
description,
date,
tags,
github,
demo,
} = project.data;
---

<BaseLayout
title={`${title} | 0xWizard`}
description={description}

>

  <article class="project-page">
    <div class="container">
      <header class="project-header">
        <a href="/projects/" class="back-link">
          ← All projects
        </a>


    <p class="terminal-label">
      $ cat /projects/{project.id}
    </p>

    <h1>{title}</h1>

    <p class="description">
      {description}
    </p>

    {date && (
      <time datetime={date.toISOString()}>
        {date.toLocaleDateString("en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })}
      </time>
    )}

    {tags.length > 0 && (
      <div class="tags">
        {tags.map((tag) => (
          <span>#{tag}</span>
        ))}
      </div>
    )}

    <div class="project-links">
      {github && (
        <a
          href={github}
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub ↗
        </a>
      )}

      {demo && (
        <a
          href={demo}
          target="_blank"
          rel="noopener noreferrer"
        >
          Live Demo ↗
        </a>
      )}
    </div>
  </header>

  <div class="project-content">
    <Content />
  </div>
</div>


  </article>
</BaseLayout>

<style>
  .project-page {
    padding: 6rem 0;
  }

  .project-header {
    max-width: 850px;
    margin-bottom: 4rem;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--muted);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.8rem;
  }

  .back-link:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .terminal-label {
    margin: 0 0 1.5rem;
    color: var(--accent);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.85rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.8rem, 6vw, 5rem);
    line-height: 1.05;
    letter-spacing: -0.05em;
  }

  .description {
    max-width: 750px;
    margin: 1.5rem 0;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .project-header time {
    color: var(--muted);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.75rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.2rem;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.75rem;
  }

  .tags span {
    color: var(--accent);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.8rem;
  }

  .project-links a {
    color: var(--accent);
  }

  .project-content {
    max-width: 850px;
  }

  .project-content :global(h2) {
    margin-top: 4rem;
    margin-bottom: 1rem;
  }

  .project-content :global(h3) {
    margin-top: 3rem;
  }

  .project-content :global(p) {
    margin: 1.2rem 0;
  }

  .project-content :global(ul),
  .project-content :global(ol) {
    padding-left: 1.5rem;
  }

  .project-content :global(li) {
    margin: 0.5rem 0;
  }

  .project-content :global(img) {
    display: block;
    max-width: 100%;
    margin: 2rem auto;
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .project-content :global(pre) {
    margin: 2rem 0;
  }

  .project-content :global(blockquote) {
    margin: 2rem 0;
    padding: 1rem 1.5rem;
    border-left: 3px solid var(--accent);
    background: var(--panel);
    color: var(--muted);
  }
</style>
